{
  "id": "com.drpeppers.floorplandashboard",
  "version": "0.2.0",
  "compatibility": ">=12.3.0",
  "sdk": 3,
  "platforms": ["local"],
  "name": {
    "en": "HomeDeck",
    "nl": "HomeDeck"
  },
  "description": {
    "en": "Your whole home in 3D with live energy, on any screen in your home",
    "nl": "Je hele huis in 3D met live energie, op elk scherm in huis"
  },
  "category": ["tools"],
  "brandColor": "#2E5BFF",
  "source": "https://github.com/WNijhof/homey-floorplan-dashboard",
  "support": "https://github.com/WNijhof/homey-floorplan-dashboard/issues",
  "bugs": { "url": "https://github.com/WNijhof/homey-floorplan-dashboard/issues" },
  "homeyCommunityTopicId": 161491,
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation",
    "homey:app:com.gruijter.powerhour",
    "homey:app:com.drpeppers.energydashboard"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "DrPeppers",
    "email": "drpeppers@duck.com"
  },
  "api": {
    "getSettingsInfo": { "method": "GET", "path": "/settings-info" },
    "setConfig": { "method": "PUT", "path": "/config" },
    "getDashboardLink": { "method": "GET", "path": "/dashboard-link" },
    "getData": { "method": "GET", "path": "/data" },
    "getPlans": { "method": "GET", "path": "/plans" },
    "savePlan": { "method": "PUT", "path": "/plans/:id" },
    "deletePlan": { "method": "DELETE", "path": "/plans/:id" },
    "setCapability": { "method": "POST", "path": "/capability" },
    "getCalendars": { "method": "GET", "path": "/calendars" },
    "setCalendars": { "method": "PUT", "path": "/calendars" },
    "getAgenda": { "method": "GET", "path": "/agenda" },
    "getDiagnosisReport": { "method": "GET", "path": "/diagnosis-report" }
  }
}
