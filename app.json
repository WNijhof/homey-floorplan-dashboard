  "flow": {
    "triggers": [
      {
        "title": {
          "en": "The cheapest hours start",
          "nl": "De goedkoopste uren beginnen"
        },
        "hint": {
          "en": "At the start of the cheapest three hours coming up.",
          "nl": "Aan het begin van de goedkoopste drie uur die eraan komen."
        },
        "id": "cheap-power"
      },
      {
        "title": {
          "en": "There is power to spare",
          "nl": "Er is stroom over"
        },
        "hint": {
          "en": "When at least 400 W starts going back to the grid.",
          "nl": "Als er minstens 400 W naar het net terug begint te gaan."
        },
        "tokens": [
          {
            "name": "watts",
            "type": "number",
            "title": {
              "en": "Watts",
              "nl": "Watt"
            },
            "example": 1200
          }
        ],
        "id": "energy-surplus"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Put on a list",
          "nl": "Zet op een lijst"
        },
        "titleFormatted": {
          "en": "Put [[text]] on [[list]]",
          "nl": "Zet [[text]] op [[list]]"
        },
        "args": [
          {
            "type": "dropdown",
            "name": "list",
            "title": {
              "en": "List",
              "nl": "Lijst"
            },
            "values": [
              {
                "id": "shopping",
                "label": {
                  "en": "the shopping list",
                  "nl": "de boodschappenlijst"
                }
              },
              {
                "id": "tasks",
                "label": {
                  "en": "the tasks",
                  "nl": "de taken"
                }
              }
            ]
          },
          {
            "type": "text",
            "name": "text",
            "title": {
              "en": "Text",
              "nl": "Tekst"
            }
          }
        ],
        "id": "add-to-list"
      },
      {
        "title": {
          "en": "Show on the screens",
          "nl": "Toon op de schermen"
        },
        "titleFormatted": {
